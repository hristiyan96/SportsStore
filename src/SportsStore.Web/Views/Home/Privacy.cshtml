@{
    ViewData["Title"] = "Privacy";
}

<section class="band">
    <div class="container">
        <div class="page-panel page-copy">
            <h1>Privacy</h1>
            <p>SportsStore stores the name, email, phone, and delivery address a customer gives when they register or place an order. That information is used to fulfil the order and to let the customer see their own history.</p>
            <p class="mb-0">Staff accounts can see orders so they can pack and ship them. Passwords are stored only as hashes. The shop does not sell customer details.</p>
        </div>
    </div>
</section>
