@model ErrorViewModel
@{
    ViewData["Title"] = "Something went wrong";
}

<section class="band">
    <div class="container">
        <div class="page-panel">
            <p class="eyebrow">SportsStore</p>
            <h1>Something went wrong</h1>
            <p class="page-copy">The shop could not finish that request. Try again in a moment.</p>
            @if (Model.ShowRequestId)
            {
                <p>Reference <code>@Model.RequestId</code></p>
            }
            <p class="mb-0"><a asp-controller="Home" asp-action="Index">Home</a></p>
        </div>
    </div>
</section>
