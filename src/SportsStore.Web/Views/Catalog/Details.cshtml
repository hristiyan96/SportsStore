@model SportsStore.Services.Catalog.ProductDetails
@{
    ViewData["Title"] = Model.Name;
}

<section class="band">
    <div class="container">
        <p class="eyebrow">@Model.CategoryName</p>
        <div class="page-panel product-detail">
            <h1>@Model.Name</h1>
            <p class="catalog-meta">@Model.BrandName · @Model.BrandCountry</p>
            <p class="page-copy">@Model.Description</p>
            <p>SKU @Model.Sku</p>
            <p class="catalog-price">@Model.Price.ToString("0.00") EUR</p>
            <p>@(Model.StockQuantity == 0 ? "Out of stock" : $"{Model.StockQuantity} in stock")</p>
            @if (TempData["CartError"] is string error)
            {
                <p class="cart-error">@error</p>
            }
            @if (Model.StockQuantity > 0)
            {
                <form asp-controller="Cart" asp-action="Add" method="post" class="cart-add">
                    <input type="hidden" name="productId" value="@Model.Id" />
                    <label for="quantity">Quantity</label>
                    <input id="quantity" name="quantity" type="number" min="1" max="@Model.StockQuantity" value="1" class="form-control" />
                    <button type="submit" class="btn btn-accent">Add to cart</button>
                </form>
            }
            <a asp-action="Index">Back to the catalog</a>
        </div>
    </div>
</section>
