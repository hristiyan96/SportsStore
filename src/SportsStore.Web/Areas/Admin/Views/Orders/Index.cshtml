@using SportsStore.Core.Enums
@model IReadOnlyList<SportsStore.Services.Admin.AdminOrderRow>
@{
    ViewData["Title"] = "Orders";
}

<section class="band">
    <div class="container">
        <p class="eyebrow">Shop floor</p>
        <h1 class="catalog-title">Orders</h1>
        <p><a asp-controller="Dashboard" asp-action="Index">Dashboard</a></p>
        <div class="page-panel">
            @if (Model.Count == 0)
            {
                <p class="mb-0">No orders yet.</p>
            }
            @foreach (var order in Model)
            {
                <article class="cart-line">
                    <div>
                        <h2><a asp-action="Details" asp-route-id="@order.Id">Order @order.Id</a></h2>
                        <p class="catalog-meta">@order.CustomerName · @order.City · @order.ItemCount item@(order.ItemCount == 1 ? "" : "s") · @order.CreatedOn.ToString("dd MMM yyyy HH:mm", System.Globalization.CultureInfo.InvariantCulture) UTC</p>
                    </div>
                    <p class="catalog-price">@order.Total.ToString("0.00") EUR</p>
                    <form asp-action="UpdateStatus" asp-route-id="@order.Id" method="post" class="d-flex gap-2 align-items-center">
                        <select name="status" class="form-select">
                            @foreach (var status in Enum.GetValues<OrderStatus>())
                            {
                                if (status == order.Status)
                                {
                                    <option value="@status" selected>@status</option>
                                }
                                else
                                {
                                    <option value="@status">@status</option>
                                }
                            }
                        </select>
                        <button type="submit" class="btn btn-accent">Save</button>
                    </form>
                </article>
            }
        </div>
    </div>
</section>
