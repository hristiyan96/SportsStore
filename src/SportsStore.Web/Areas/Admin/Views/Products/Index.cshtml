@model IReadOnlyList<SportsStore.Services.Admin.AdminProductRow>
@{
    ViewData["Title"] = "Products";
}

<section class="band">
    <div class="container">
        <p class="eyebrow">Shop floor</p>
        <h1 class="catalog-title">Products</h1>
        <p><a asp-action="Create">Add a product</a> · <a asp-controller="Dashboard" asp-action="Index">Dashboard</a></p>
        <div class="page-panel">
            @foreach (var product in Model)
            {
                <article class="cart-line">
                    <div>
                        <h2>@product.Name</h2>
                        <p class="catalog-meta">@product.Sku · @product.CategoryName · @product.BrandName · @(product.IsActive ? "On sale" : "Inactive")</p>
                    </div>
                    <p class="catalog-price">@product.Price.ToString("0.00") EUR</p>
                    <p>@product.StockQuantity in stock</p>
                    <div>
                        <a asp-action="Edit" asp-route-id="@product.Id">Edit</a>
                        @if (product.IsActive)
                        {
                            <form asp-action="Deactivate" asp-route-id="@product.Id" method="post">
                                <button type="submit" class="btn btn-link cart-remove">Deactivate</button>
                            </form>
                        }
                    </div>
                </article>
            }
        </div>
    </div>
</section>
