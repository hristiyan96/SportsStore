@model StoreDashboard
@{
    ViewData["Title"] = "Dashboard";
}

<section class="band">
    <div class="container">
        <p class="eyebrow">Shop floor</p>
        <h1 class="catalog-title">Dashboard</h1>
        <p>
            <a asp-controller="Products" asp-action="Index">Products</a>
            · <a asp-controller="Orders" asp-action="Index">Orders</a>
            · <a asp-controller="Categories" asp-action="Index">Categories</a>
            · <a asp-controller="Brands" asp-action="Index">Brands</a>
        </p>
        <div class="row g-4">
            <div class="col-md-4">
                <article class="sport-card">
                    <h2>Orders</h2>
                    <p class="catalog-price">@Model.OrderCount</p>
                    <p class="mb-0">@Model.PendingOrderCount pending</p>
                </article>
            </div>
            <div class="col-md-4">
                <article class="sport-card">
                    <h2>Order value</h2>
                    <p class="catalog-price">@Model.OrderTotal.ToString("0.00") EUR</p>
                    <p class="mb-0">Across every placed order</p>
                </article>
            </div>
            <div class="col-md-4">
                <article class="sport-card">
                    <h2>Stock</h2>
                    <p class="catalog-price">@Model.UnitsInStock</p>
                    <p class="mb-0">@Model.ProductCount products, @Model.OutOfStockCount out of stock</p>
                </article>
            </div>
        </div>
    </div>
</section>
