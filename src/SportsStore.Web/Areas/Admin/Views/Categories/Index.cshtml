@model IReadOnlyList<SportsStore.Services.Admin.CatalogEntryRow>
@{
    ViewData["Title"] = "Categories";
}

<section class="band">
    <div class="container">
        <p class="eyebrow">Shop floor</p>
        <h1 class="catalog-title">Categories</h1>
        <p><a asp-action="Create">Add a category</a> · <a asp-controller="Dashboard" asp-action="Index">Dashboard</a></p>
        <div class="page-panel">
            @foreach (var category in Model)
            {
                <article class="cart-line">
                    <div>
                        <h2>@category.Name</h2>
                        <p class="catalog-meta">@(string.IsNullOrWhiteSpace(category.Detail) ? "No description" : category.Detail) · @(category.IsActive ? "Shown in the shop" : "Hidden")</p>
                    </div>
                    <p>@category.ProductCount product@(category.ProductCount == 1 ? "" : "s")</p>
                    <div>
                        <a asp-action="Edit" asp-route-id="@category.Id">Edit</a>
                        @if (category.IsActive)
                        {
                            <form asp-action="Deactivate" asp-route-id="@category.Id" method="post">
                                <button type="submit" class="btn btn-link cart-remove">Hide</button>
                            </form>
                        }
                    </div>
                </article>
            }
        </div>
    </div>
</section>
