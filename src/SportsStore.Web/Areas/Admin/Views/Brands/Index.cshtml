@model IReadOnlyList<SportsStore.Services.Admin.CatalogEntryRow>
@{
    ViewData["Title"] = "Brands";
}

<section class="band">
    <div class="container">
        <p class="eyebrow">Shop floor</p>
        <h1 class="catalog-title">Brands</h1>
        <p><a asp-action="Create">Add a brand</a> · <a asp-controller="Dashboard" asp-action="Index">Dashboard</a></p>
        <div class="page-panel">
            @foreach (var brand in Model)
            {
                <article class="cart-line">
                    <div>
                        <h2>@brand.Name</h2>
                        <p class="catalog-meta">@brand.Detail · @(brand.IsActive ? "Shown in the shop" : "Hidden")</p>
                    </div>
                    <p>@brand.ProductCount product@(brand.ProductCount == 1 ? "" : "s")</p>
                    <div>
                        <a asp-action="Edit" asp-route-id="@brand.Id">Edit</a>
                        @if (brand.IsActive)
                        {
                            <form asp-action="Deactivate" asp-route-id="@brand.Id" method="post">
                                <button type="submit" class="btn btn-link cart-remove">Hide</button>
                            </form>
                        }
                    </div>
                </article>
            }
        </div>
    </div>
</section>
