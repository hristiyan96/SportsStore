@model SportsStore.Web.Models.BrandForm
@{
    ViewData["Title"] = "Add brand";
}

<section class="band">
    <div class="container">
        <div class="page-panel account-form">
            <p class="eyebrow">Shop floor</p>
            <h1>Add brand</h1>
            <form method="post" asp-action="Create">
                <partial name="_BrandFields" model="Model" />
                <button type="submit" class="btn btn-accent">Save</button>
            </form>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
